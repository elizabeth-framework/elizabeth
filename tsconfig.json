{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "packages/*/src/**/*.ts", "tests/tests.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".elizabeth",
    "packages/*/dist",
    "packages/*/out",
    "packages/vscode-elizabeth/out"
  ]
}
