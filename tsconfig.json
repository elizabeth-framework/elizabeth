{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "dist", ".elizabeth", "packages/*/dist", "packages/*/out", "packages/vscode-elizabeth/out"]
}
