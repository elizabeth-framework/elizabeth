{
  "name": "@elizabeth-js/elizabeth",
  "version": "0.0.6",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "elizabeth": "bin/elizabeth"
  },
  "files": [
    "assets",
    "bin",
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/elizabeth.ts",
    "./client": "./src/client.ts",
    "./route": "./src/route.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test ./tests ./packages/*/tests",
    "test:packages": "bun test ./packages/*/tests",
    "smoke": "bun run src/dev/smoke.ts",
    "dev": "bun run src/dev/server.ts",
    "build": "bun run src/cli.ts build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "biome": "biome check --write .",
    "biome:ci": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "oxc-parser": "^0.128.0"
  }
}
