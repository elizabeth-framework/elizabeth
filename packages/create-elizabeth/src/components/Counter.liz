const frameworkName = "Elizabeth"
const featureLabel = (feature) => `${feature} test`


import { clientState } from "elizabeth/client"

const counterWrapper = "counter-wrapper"

@client
@public
<Counter>

  const [count, setCount] = clientState(0);

  <style>
    .counter-wrapper {
      width: 100%;
      max-width: 26rem;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 1.25rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      position: relative;
    }

    .counter-label {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #64748b;
      margin-bottom: -0.25rem;
    }

    .counter-display {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 0.5rem 0;
    }

    .counter-value {
      font-size: 4rem;
      font-weight: 800;
      color: #ffffff;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      text-shadow: 0 0 30px rgba(255, 255, 255, 0.1);
    }

    .counter-actions {
      display: flex;
      gap: 0.75rem;
    }

    .counter-btn {
      flex: 1;
      padding: 0.75rem;
      font-size: 0.9rem;
      font-weight: 700;
      border-radius: 0.75rem;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      outline: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .btn-increment {
      background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
      border: none;
      color: white;
      box-shadow: 0 4px 15px rgba(124, 58, 237, 0.3);
    }

    .btn-increment:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(124, 58, 237, 0.4);
      filter: brightness(1.1);
    }

    .btn-increment:active {
      transform: translateY(0);
    }

    .btn-reset {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #94a3b8;
    }

    .btn-reset:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #ffffff;
      border-color: rgba(255, 255, 255, 0.2);
    }

    .btn-reset:active {
      transform: scale(0.98);
    }

  </style>

  <div className="counter-wrapper">
    <span className="counter-label">Interactive Demo {(frameworkName)}</span>
    <div className="counter-display">
      <div className="counter-value">{count}</div>
    </div>
    <div className="counter-actions">
      <button className="counter-btn btn-increment" onClick={() => setCount(count + 1)}>
        <span>Increment</span>
        <span style="font-size: 1.2rem">+</span>
      </button>
      <button className="counter-btn btn-reset" onClick={() => setCount(0)}>
        Reset
      </button>
    </div>
  </div>
</Counter>
