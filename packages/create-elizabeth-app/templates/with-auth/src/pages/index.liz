@default
<HomePage>
  <style>
    .container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2rem;
      max-width: 540px;
    }

    h1 {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: #f1f5f9;
    }

    p {
      color: #94a3b8;
      font-size: 0.9rem;
      line-height: 1.5;
      text-align: center;
    }

