@default
<LoadingPage>
  <style>
    .loading-page {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      color: #475569;
      font-size: 0.9rem;
    }

    .loading-indicator {
      width: 2rem;
      height: 2rem;
      border: 3px solid #cbd5e1;
      border-top-color: #475569;
      border-radius: 999px;
      animation: elizabeth-spin 0.8s linear infinite;
    }

    @keyframes elizabeth-spin {
      to { transform: rotate(360deg); }
    }
  </style>

  <div className="loading-page">
    <div className="loading-indicator"></div>
    <p>Loading...</p>
  </div>
</LoadingPage>

