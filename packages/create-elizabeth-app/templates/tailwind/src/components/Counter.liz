import { clientState } from "elizabeth/client"


@client
@public
<Counter>

  const [count, setCount] = clientState(0);

  <div className="w-72 bg-white/[0.02] border border-white/[0.06] rounded-2xl p-8 flex flex-col items-center gap-6 backdrop-blur-md">
    <span className="text-7xl font-extrabold text-white leading-none tabular-nums tracking-tighter">
      {count}
    </span>
    <div className="flex gap-2 w-full">
      <button
        className="flex-1 px-4 py-3 text-sm font-bold rounded-xl bg-violet-600 text-white hover:bg-violet-700 hover:-translate-y-0.5 active:translate-y-0 transition cursor-pointer outline-none"
        onClick={() => setCount(count + 1)}
      >
        Increment
      </button>
      <button
        className="flex-1 px-4 py-3 text-sm font-bold rounded-xl bg-transparent border border-white/[0.08] text-slate-500 hover:border-white/[0.15] hover:text-slate-400 active:scale-[0.98] transition cursor-pointer outline-none"
        onClick={() => setCount(0)}
      >
        Reset
      </button>
    </div>
  </div>
</Counter>
