@default
<ErrorPage>
  <div className="flex flex-col items-center gap-3 text-center">
    <h1 className="text-5xl font-extrabold text-slate-100 leading-none">Something went wrong.</h1>
    <p className="text-sm text-slate-400">{ctx.error?.message ?? "The page failed to render."}</p>
    <code className="text-xs text-slate-500">error.liz</code>
  </div>
</ErrorPage>
