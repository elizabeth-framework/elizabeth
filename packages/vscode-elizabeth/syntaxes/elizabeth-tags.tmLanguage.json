{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "elizabeth.injections.tags",
  "injectionSelector": "L:source.elizabeth - comment",
  "patterns": [
    {
        "include": "#imports"
    },
    {
        "match": "(?<!\\w)@(public|default|declare|private|client)\\b",
        "name": "keyword.control.elizabeth"
    },
    {
        "match": "\\b(const|let|var)\\b",
        "name": "storage.type.elizabeth"
    },
    {
        "match": "\\b(if|else|for|while|switch|case|return|throw|try|catch|finally|async|await|function|import|export|type|interface|enum|class)\\b",
        "name": "keyword.control.elizabeth"
    },
    {
        "match": "(?<=[>}])([^<{}\\n]+)(?=<|\\{|$)",
        "captures": {
            "1": {
            "name": "text.html.elizabeth"
            }
        }
    },
    {
      "match": "(</?)([A-Za-z][A-Za-z0-9_:.\\-]*)([^>]*)(/?>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.elizabeth"
        },
        "3": {
          "patterns": [
            { "include": "#attributes" },
            { "include": "#strings" },
            { "include": "source.tsx" }
          ]
        },
        "4": {
          "name": "punctuation.definition.tag.end.html"
        }
      }
    }
  ],
  "repository": {
    "imports": {
      "patterns": [
        {
          "match": "\\b(import)\\b(?:(\\s+)(type)\\b)?(?:(\\s+)([A-Za-z_$][\\w$]*|\\{[^\\n]*?\\}|\\*\\s+as\\s+[A-Za-z_$][\\w$]*)(\\s+)(from)\\s*)?(\"[^\"\\n]*\"|'[^'\\n]*')",
          "captures": {
            "1": { "name": "keyword.control.import.ts" },
            "3": { "name": "storage.modifier.type.ts" },
            "5": { "patterns": [{ "include": "source.tsx" }] },
            "7": { "name": "keyword.control.from.ts" },
            "8": { "name": "string.quoted.module.ts" }
          }
        },
        {
          "match": "\\b(export)\\b(?:(\\s+)(type)\\b)?(?:(\\s+)(\\{[^\\n]*?\\}|\\*)\\s*(?:(as)\\s+[A-Za-z_$][\\w$]*)?(\\s+)(from)\\s*)?(\"[^\"\\n]*\"|'[^'\\n]*')",
          "captures": {
            "1": { "name": "keyword.control.export.ts" },
            "3": { "name": "storage.modifier.type.ts" },
            "5": { "patterns": [{ "include": "source.tsx" }] },
            "6": { "name": "keyword.control.as.ts" },
            "8": { "name": "keyword.control.from.ts" },
            "9": { "name": "string.quoted.module.ts" }
          }
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_:][A-Za-z0-9_:.-]*)(?=\\s*=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.html"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.html"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.html"
        }
      ]
    }
  }
}
