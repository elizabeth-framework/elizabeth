{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Elizabeth",
  "scopeName": "source.elizabeth",
  "patterns": [
    { "include": "#decorators" },
    { "include": "#component" },
    { "include": "#elizabeth-block" },
    { "include": "#elizabeth-tags" },
    { "include": "source.tsx" }
  ],
  "repository": {
    "decorators": {
      "patterns": [
        {
          "match": "(?<!\\w)@(public|default|declare|private|client)\\b",
          "name": "keyword.control.elizabeth"
        }
      ]
    },

    "component": {
      "patterns": [
        {
          "begin": "(<)([A-Z][A-Za-z0-9_:.\\-]*)([^>]*)(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.elizabeth" },
            "2": { "name": "entity.name.tag.elizabeth" },
            "3": { "patterns": [{ "include": "#tag-attributes" }] },
            "4": { "name": "punctuation.definition.tag.end.elizabeth" }
          },
          "end": "(</)(\\2)(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.elizabeth" },
            "2": { "name": "entity.name.tag.elizabeth" },
            "3": { "name": "punctuation.definition.tag.end.elizabeth" }
          },
          "patterns": [
            { "include": "#decorators" },
            { "include": "#logic-line" },
            { "include": "#elizabeth-block" },
            { "include": "#elizabeth-tags" },
            { "include": "source.tsx" }
          ]
        }
      ]
    },

    "elizabeth-block": {
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.block.begin.elizabeth" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.elizabeth" }
          },
          "patterns": [
            { "include": "#decorators" },
            { "include": "#logic-line" },
            { "include": "#elizabeth-block" },
            { "include": "#elizabeth-tags" },
            { "include": "source.tsx" }
          ]
        }
      ]
    },

    "elizabeth-tags": {
      "patterns": [
        {
          "match": "(</?)([A-Za-z][A-Za-z0-9_:.\\-]*)([^>]*)(/?>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.elizabeth" },
            "2": { "name": "entity.name.tag.elizabeth" },
            "3": { "patterns": [{ "include": "#tag-attributes" }] },
            "4": { "name": "punctuation.definition.tag.end.elizabeth" }
          }
        }
      ]
    },

    "tag-attributes": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_:][A-Za-z0-9_:.-]*)(?=\\s*=)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.elizabeth" }
          }
        },
        { "include": "source.tsx" }
      ]
    },
    "logic-line": {
      "patterns": [
        { "include": "#imports" },
        {
          "begin": "^\\s*(?=(const|let|var|function|async|await|if|else|for|while|switch|case|return|throw|try|catch|finally|import|export|type|interface|enum|class)\\b)",
          "end": "$",
          "patterns": [
            { "include": "#elizabeth-block" },
            { "include": "#elizabeth-tags" },
            { "include": "source.tsx" }
          ]
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "\\b(import)\\b(?:(\\s+)(type)\\b)?(?:(\\s+)([A-Za-z_$][\\w$]*|\\{[^\\n]*?\\}|\\*\\s+as\\s+[A-Za-z_$][\\w$]*)(\\s+)(from)\\s*)?(\"[^\"\\n]*\"|'[^'\\n]*')",
          "captures": {
            "1": { "name": "keyword.control.import.ts" },
            "3": { "name": "storage.modifier.type.ts" },
            "5": { "patterns": [{ "include": "source.tsx" }] },
            "7": { "name": "keyword.control.from.ts" },
            "8": { "name": "string.quoted.module.ts" }
          }
        },
        {
          "match": "\\b(export)\\b(?:(\\s+)(type)\\b)?(?:(\\s+)(\\{[^\\n]*?\\}|\\*)\\s*(?:(as)\\s+[A-Za-z_$][\\w$]*)?(\\s+)(from)\\s*)?(\"[^\"\\n]*\"|'[^'\\n]*')",
          "captures": {
            "1": { "name": "keyword.control.export.ts" },
            "3": { "name": "storage.modifier.type.ts" },
            "5": { "patterns": [{ "include": "source.tsx" }] },
            "6": { "name": "keyword.control.as.ts" },
            "8": { "name": "keyword.control.from.ts" },
            "9": { "name": "string.quoted.module.ts" }
          }
        }
      ]
    }
  }
}
