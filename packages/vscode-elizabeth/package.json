{
  "name": "vscode-elizabeth-language-extension",
  "displayName": "Elizabeth Language Extension",
  "description": "Language support for Elizabeth framework.",
  "publisher": "Shinapri",
  "repository": {
    "type": "git",
    "url": "https://github.com/elizabeth-js/elizabeth.git"
  },
  "version": "0.0.1",
  "icon": "./assets/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/vscode-elizabeth/src/extension.js",
  "activationEvents": [
    "onLanguage:elizabeth"
  ],
  "contributes": {
    "configurationDefaults": {
      "[elizabeth]": {
        "editor.linkedEditing": true
      }
    },
    "languages": [
      {
        "id": "elizabeth",
        "extensions": [".liz"],
        "aliases": ["Elizabeth", "liz"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "elizabeth",
        "scopeName": "source.elizabeth",
        "path": "./syntaxes/elizabeth.tmLanguage.json"
      },
      {
        "scopeName": "elizabeth.injections.style",
        "path": "./syntaxes/elizabeth-style.tmLanguage.json",
        "injectTo": ["source.elizabeth"]
      },
      {
        "scopeName": "elizabeth.injections.tags",
        "path": "./syntaxes/elizabeth-tags.tmLanguage.json",
        "injectTo": ["source.elizabeth"]
      }
    ]
  },
  "scripts": {
    "build:client": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/vscode-elizabeth/src/extension.js",
    "build:server": "tsup ../language-server/src/index.ts --format cjs --out-dir ./out/language-server/src && cp ../../node_modules/typescript/lib/lib.*.d.ts ./out/language-server/src/",
    "build": "bun run build:client && bun run build:server",
    "package": "bun run build && npm exec --package @vscode/vsce -- vsce package --allow-missing-repository --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@volar/vscode": "^2.4.28",
    "vscode-languageclient": "^9.0.1"
  },
  "extensionDependencies": [
    "vscode.typescript-language-features"
  ]
}