@default
<UsersLayout>
  const currentUser = ctx.params.id;

  <section className="users-shell">
    <aside className="users-sidebar">
      <strong>Users</strong>
      <p>Viewing {currentUser}</p>
    </aside>
    <div className="users-content">
      {children}
    </div>
  </section>
</UsersLayout>
