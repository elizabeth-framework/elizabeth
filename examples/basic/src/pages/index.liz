import { Card } from "../components/Card.liz"
import { ClientBadge } from "../components/ClientBadge.liz"
import { Counter } from "../components/Counter.liz"
import styles, { note } from "./Home.module.css"

const frameworkName = "Elizabeth";
const featureLabel = (feature) => feature;

import { Button } from "../components/Button.liz"

@default
<HomePage>
  const name = frameworkName;
  const speed = "zero-JS by default";
  const features = ["plain JS control flow", "nested markup", "no @if syntax"].map(featureLabel);

  <main className={`shell ${styles.hero}`}>
    <!-- Elizabeth preserves HTML comments. -->
    <Card
      title="Fast server component"
      description={speed}
    >
      <strong>Component props are declaration locals.</strong>
    </Card>
    <p className={note}>This line is styled by a CSS module.</p>
    {
      if (features.length > 0) {
        <ul>
          {
            for (const feature of features) {
              <li>{feature}</li>
            }
          }
        </ul>
      } else {
        <p>No features yet.</p>
      }
    }
    <ClientBadge label="client island marker" />
    <Counter />
    <Button>Default action</Button>
    <Button variant="secondary" disabled={true}>Disabled action</Button>
  </main>
</HomePage>
