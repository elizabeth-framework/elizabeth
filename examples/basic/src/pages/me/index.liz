

@default
<HomePage>
  <body style="margin:0; font-family:Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background:#050816; color:white; overflow-x:hidden;">

  <main style="min-height:100vh; background:radial-gradient(circle at top left, rgba(124,58,237,.35), transparent 35%), radial-gradient(circle at top right, rgba(14,165,233,.25), transparent 35%), linear-gradient(135deg, #050816 0%, #0f172a 55%, #111827 100%);">

    <nav style="display:flex; align-items:center; justify-content:space-between; padding:28px 8%; position:relative; z-index:2;">
      <div style="font-size:24px; font-weight:800; letter-spacing:-0.04em;">
        Nova<span style="color:#8b5cf6;">Labs</span>
      </div>

      <div style="display:flex; gap:26px; font-size:14px; color:#cbd5e1;">
        <a href="#" style="color:inherit; text-decoration:none;">Product</a>
        <a href="#" style="color:inherit; text-decoration:none;">Features</a>
        <a href="#" style="color:inherit; text-decoration:none;">Pricing</a>
      </div>

      <button style="border:1px solid rgba(255,255,255,.18); background:rgba(255,255,255,.08); color:white; padding:10px 18px; border-radius:999px; backdrop-filter:blur(12px); cursor:pointer;">
        Get Started
      </button>
    </nav>

    <section style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); align-items:center; gap:60px; padding:80px 8% 100px; position:relative; z-index:1;">

      <div>
        <div style="display:inline-flex; align-items:center; gap:8px; padding:8px 14px; border-radius:999px; background:rgba(139,92,246,.14); border:1px solid rgba(139,92,246,.35); color:#c4b5fd; font-size:14px; margin-bottom:22px;">
          ✦ AI-native platform for builders
        </div>

        <h1 style="font-size:clamp(46px, 7vw, 84px); line-height:.96; letter-spacing:-0.075em; margin:0 0 24px; max-width:780px;">
          Build faster with an elegant AI workspace.
        </h1>

        <p style="font-size:18px; line-height:1.75; color:#cbd5e1; max-width:620px; margin:0 0 34px;">
          Turn your ideas into polished products with smart automation, clean workflows,
          and beautiful tools designed for serious creators.
        </p>

        <div style="display:flex; flex-wrap:wrap; gap:14px;">
          <button style="background:linear-gradient(135deg,#8b5cf6,#06b6d4); color:white; border:none; padding:15px 24px; border-radius:16px; font-weight:700; font-size:15px; cursor:pointer; box-shadow:0 18px 50px rgba(139,92,246,.35);">
            Start Building
          </button>

          <button style="background:rgba(255,255,255,.08); color:white; border:1px solid rgba(255,255,255,.16); padding:15px 24px; border-radius:16px; font-weight:700; font-size:15px; cursor:pointer; backdrop-filter:blur(10px);">
            View Demo
          </button>
        </div>

        <div style="display:flex; gap:28px; margin-top:46px; color:#cbd5e1;">
          <div>
            <div style="font-size:28px; font-weight:800; color:white;">12k+</div>
            <div style="font-size:14px;">Active users</div>
          </div>
          <div>
            <div style="font-size:28px; font-weight:800; color:white;">98%</div>
            <div style="font-size:14px;">Faster workflow</div>
          </div>
          <div>
            <div style="font-size:28px; font-weight:800; color:white;">24/7</div>
            <div style="font-size:14px;">Automation</div>
          </div>
        </div>
      </div>

      <div style="position:relative;">
        <div style="position:absolute; inset:-40px; background:linear-gradient(135deg, rgba(139,92,246,.45), rgba(6,182,212,.25)); filter:blur(80px); border-radius:40px;"></div>

        <div style="position:relative; background:rgba(15,23,42,.72); border:1px solid rgba(255,255,255,.14); border-radius:32px; padding:22px; box-shadow:0 30px 120px rgba(0,0,0,.55); backdrop-filter:blur(20px);">

          <div style="display:flex; gap:8px; margin-bottom:20px;">
            <span style="width:12px; height:12px; border-radius:50%; background:#fb7185;"></span>
            <span style="width:12px; height:12px; border-radius:50%; background:#facc15;"></span>
            <span style="width:12px; height:12px; border-radius:50%; background:#34d399;"></span>
          </div>

          <div style="background:#020617; border-radius:24px; padding:24px; border:1px solid rgba(255,255,255,.08);">
            <div style="font-size:13px; color:#94a3b8; margin-bottom:10px;">Project status</div>

            <div style="font-size:28px; font-weight:800; margin-bottom:18px;">
              Launch Dashboard
            </div>

            <div style="display:grid; gap:14px;">
              <div style="padding:16px; border-radius:18px; background:linear-gradient(135deg, rgba(139,92,246,.22), rgba(15,23,42,.8)); border:1px solid rgba(139,92,246,.25);">
                <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
                  <span style="font-weight:700;">AI Pipeline</span>
                  <span style="color:#34d399;">Live</span>
                </div>
                <div style="height:8px; background:rgba(255,255,255,.1); border-radius:999px; overflow:hidden;">
                  <div style="width:86%; height:100%; background:linear-gradient(90deg,#8b5cf6,#06b6d4); border-radius:999px;"></div>
                </div>
              </div>

              <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
                <div style="padding:18px; border-radius:18px; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.08);">
                  <div style="font-size:12px; color:#94a3b8;">Tasks</div>
                  <div style="font-size:26px; font-weight:800;">128</div>
                </div>

                <div style="padding:18px; border-radius:18px; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.08);">
                  <div style="font-size:12px; color:#94a3b8;">Deploys</div>
                  <div style="font-size:26px; font-weight:800;">42</div>
                </div>
              </div>

              <div style="padding:16px; border-radius:18px; background:rgba(6,182,212,.1); border:1px solid rgba(6,182,212,.22); color:#cffafe;">
                “Your landing page is ready for production.”
              </div>
            </div>
          </div>
        </div>
      </div>

    </section>

    <section style="padding:0 8% 80px;">
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:18px;">
        <div style="padding:24px; border-radius:24px; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1); backdrop-filter:blur(12px);">
          <div style="font-size:28px; margin-bottom:12px;">⚡</div>
          <h3 style="margin:0 0 8px;">Fast by default</h3>
          <p style="margin:0; color:#94a3b8; line-height:1.6;">Optimized layouts, clean structure, and smooth user experience.</p>
        </div>

        <div style="padding:24px; border-radius:24px; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1); backdrop-filter:blur(12px);">
          <div style="font-size:28px; margin-bottom:12px;">🧠</div>
          <h3 style="margin:0 0 8px;">AI workflow</h3>
          <p style="margin:0; color:#94a3b8; line-height:1.6;">Automate boring tasks and focus on building what matters.</p>
        </div>

        <div style="padding:24px; border-radius:24px; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1); backdrop-filter:blur(12px);">
          <div style="font-size:28px; margin-bottom:12px;">✨</div>
          <h3 style="margin:0 0 8px;">Beautiful UI</h3>
          <p style="margin:0; color:#94a3b8; line-height:1.6;">Modern glassmorphism style with gradient lighting and depth.</p>
        </div>
      </div>
    </section>

  </main>

</body>
</HomePage>