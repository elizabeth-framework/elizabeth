import { clientState } from "elizabeth/client"

@client
@public
<Counter>
  const state = clientState;
  const Elizabeth = { clientState };
  const [count, setCount] = clientState(0);
  const [step, setStep] = state(1);
  const [limit, setLimit] = Elizabeth.clientState(3);

  <div className={count === 0 ? "counter counter-zero" : `counter counter-active step-${step}`}>
    <button onClick={() => setCount(count - step)}>-</button>
    <span>{count}</span>
    <button disabled={count >= step * limit} onClick={() => setCount(count + step)}>+</button>
    <button onClick={() => setStep(step + 1)}>Step {step}</button>
    <button onClick={() => setLimit(limit + 1)}>Limit {limit}</button>
    <small>Next: {count + step}</small>
    <small>Max: {step * limit}</small>
    <small>{count === 0 ? "zero" : "changed"}</small>
    <small>{count % step === 0 ? "aligned" : "offset"}</small>
  </div>
</Counter>
