@default
<RootLayout>
  <html lang="en">
    <head>
      <title>Elizabeth SQLite Blog</title>
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <style>
        .shell {
          width: min(960px, calc(100% - 32px));
          margin: 0 auto;
          padding: 32px 0 56px;
        }

        .topbar {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 16px;
          padding-bottom: 28px;
        }

        .brand {
          font-size: 18px;
          font-weight: 800;
          text-decoration: none;
        }

        .nav {
          display: flex;
          gap: 12px;
          font-size: 14px;
          font-weight: 700;
        }

        .nav a {
          text-decoration: none;
        }
      </style>
    </head>
    <body>
      <div className="shell">
        <header className="topbar">
          <a className="brand" href="/">SQLite Blog</a>
          <nav className="nav">
            <a href="/">Posts</a>
          </nav>
        </header>
        {children}
      </div>
    </body>
  </html>
</RootLayout>
