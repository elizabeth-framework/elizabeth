import { getPost } from "@/db.ts";
import { notFound } from "elizabeth/route";

@default
<PostPage>
  const post = getPost(ctx.params.slug);

  if (!post) {
    return notFound();
  }

  <style>
    .post {
      display: grid;
      gap: 20px;
      max-width: 720px;
    }

    .back {
      color: #4b5563;
      font-size: 14px;
      font-weight: 800;
      text-decoration: none;
    }

    .post h1 {
      margin: 0;
      color: #111827;
      font-size: 42px;
      line-height: 1.05;
    }

    .meta {
      margin: 0;
      color: #6b7280;
      font-size: 14px;
      font-weight: 700;
    }

    .body {
      white-space: pre-wrap;
      color: #374151;
      font-size: 18px;
      line-height: 1.75;
    }
  </style>

  <main className="post">
    <a className="back" href="/">Back to posts</a>
    <header>
      <h1>{post.title}</h1>
      <p className="meta">{new Date(post.created_at).toLocaleString()}</p>
    </header>
    <article className="body">{post.body}</article>
  </main>
</PostPage>
