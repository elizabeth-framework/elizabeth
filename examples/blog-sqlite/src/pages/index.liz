import { listPosts } from "@/db.ts";

@default
<BlogIndex>
  const posts = listPosts();

  <style>
    .hero {
      display: grid;
      gap: 12px;
      margin-bottom: 28px;
    }

    .hero h1 {
      margin: 0;
      font-size: 40px;
      line-height: 1.05;
      color: #111827;
    }

    .hero p {
      margin: 0;
      max-width: 560px;
      color: #4b5563;
      line-height: 1.6;
    }

    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 24px;
      align-items: start;
    }

    .posts {
      display: grid;
      gap: 14px;
    }

    .post {
      display: grid;
      gap: 8px;
      padding: 18px;
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      text-decoration: none;
    }

    .post h2 {
      margin: 0;
      font-size: 20px;
      color: #111827;
    }

    .post p {
      margin: 0;
      color: #4b5563;
      line-height: 1.55;
    }

    .date {
      color: #6b7280;
      font-size: 13px;
      font-weight: 700;
    }

    .composer {
      display: grid;
      gap: 12px;
      padding: 18px;
      background: #111827;
      color: #fff;
      border-radius: 8px;
    }

    .composer h2 {
      margin: 0;
      font-size: 18px;
    }

    .field {
      display: grid;
      gap: 6px;
    }

    .field span {
      font-size: 13px;
      font-weight: 800;
      color: #d1d5db;
    }

    .field input,
    .field textarea {
      width: 100%;
      box-sizing: border-box;
      border: 1px solid #374151;
      background: #1f2937;
      color: #fff;
      border-radius: 6px;
      padding: 10px 11px;
    }

    .field textarea {
      min-height: 118px;
      resize: vertical;
    }

    .composer button {
      border: 0;
      border-radius: 6px;
      padding: 10px 12px;
      background: #f9fafb;
      color: #111827;
      font-weight: 800;
      cursor: pointer;
    }

    @media (max-width: 760px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main>
    <section className="hero">
      <h1>Elizabeth SQLite Blog</h1>
      <p>A normal server-rendered app using Bun SQLite, page routes, API routes, redirects, dynamic routes, forms, and global CSS.</p>
    </section>

    <div className="grid">
      <section className="posts">
        {for (const post of posts) {
          <a className="post" href={`/posts/${post.slug}`}>
            <span className="date">{new Date(post.created_at).toLocaleString()}</span>
            <h2>{post.title}</h2>
            <p>{post.excerpt}</p>
          </a>
        }}
      </section>

      <form className="composer" method="post" action="/api/posts">
        <h2>Write a post</h2>
        <label className="field">
          <span>Title</span>
          <input name="title" required />
        </label>
        <label className="field">
          <span>Excerpt</span>
          <input name="excerpt" required />
        </label>
        <label className="field">
          <span>Body</span>
          <textarea name="body" required></textarea>
        </label>
        <button type="submit">Publish</button>
      </form>
    </div>
  </main>
</BlogIndex>
