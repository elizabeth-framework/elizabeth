@default
<GuideNestedDynamicPage>
  <section className="panel">
    <h1>Configured page root: /guide/{ctx.params.dir}/{ctx.params.dirInside}</h1>
    <div className="params">
      <div className="param">
        <span>dir</span>
        <strong>{ctx.params.dir}</strong>
      </div>
      <div className="param">
        <span>dirInside</span>
        <strong>{ctx.params.dirInside}</strong>
      </div>
    </div>
    <p>This page comes from <code>src/extra-pages</code>, mounted at <code>/guide</code>.</p>
  </section>
</GuideNestedDynamicPage>

