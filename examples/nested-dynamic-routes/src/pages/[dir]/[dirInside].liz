@default
<NestedDynamicPage>
  <section className="panel">
    <h1>Page route: /{ctx.params.dir}/{ctx.params.dirInside}</h1>
    <div className="params">
      <div className="param">
        <span>dir</span>
        <strong>{ctx.params.dir}</strong>
      </div>
      <div className="param">
        <span>dirInside</span>
        <strong>{ctx.params.dirInside}</strong>
      </div>
    </div>
    <p>Matching API: <code>/api/{ctx.params.dir}/{ctx.params.dirInside}</code></p>
  </section>
</NestedDynamicPage>

